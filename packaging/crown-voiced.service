[Unit]
Description=CrownOS voice enhancement service
Documentation=https://github.com/Crown-OS/crownos-voice
Requires=crown-voiced.socket
After=crown-voiced.socket pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/crown-voiced
Restart=on-failure
NoNewPrivileges=yes
LockPersonality=yes

[Install]
WantedBy=default.target
Also=crown-voiced.socket
